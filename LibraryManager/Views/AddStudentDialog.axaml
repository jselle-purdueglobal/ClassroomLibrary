<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:LibraryManager.ViewModels"
             x:DataType="vm:StudentsViewModel"
             x:Class="LibraryManager.Views.AddStudentDialog">
    <StackPanel Spacing="10" Orientation="Horizontal">
            <TextBox Text="{Binding AddFirstName}" Width="150" Watermark="First Name" />
            <TextBox Text="{Binding AddLastName}" Width="150" Watermark="Last Name" />
    </StackPanel>
</UserControl>