<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LibraryManager.ViewModels"
             x:DataType="vm:StudentsViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LibraryManager.Views.ConfirmDeleteDialog">
    <StackPanel>
        <TextBlock FontWeight="Bold">The following students will be deleted:</TextBlock>
        <ItemsControl ItemsSource="{Binding StudentsToDelete}"
                      Margin="0 5 0 0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="{Binding FirstName}" Margin="0,0,1,0"/>
                            <TextBlock Text="{Binding LastName}"/>
                        </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
