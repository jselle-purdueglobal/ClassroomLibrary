<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LibraryManager.Views.DashboardView">

    <UserControl.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 0 20"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Dashboard" Classes="header"/>

            <!-- Quick Stats -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="Library Overview" Classes="cardTitle"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Total Books:" Grid.Column="0" Grid.Row="0"/>
                        <TextBlock Text="0" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right"/>
                        <TextBlock Text="Active Students:" Grid.Column="0" Grid.Row="1"/>
                        <TextBlock Text="0" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recent Activities -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="Recent Activities" Classes="cardTitle"/>
                    <DataGrid Height="200" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Width="*"/>
                            <DataGridTextColumn Header="Activity" Width="2*"/>
                            <DataGridTextColumn Header="User" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Most Popular Books -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="Most Popular Books" Classes="cardTitle"/>
                    <ListBox Height="150">
                        <ListBoxItem>Book Title 1</ListBoxItem>
                        <ListBoxItem>Book Title 2</ListBoxItem>
                        <ListBoxItem>Book Title 3</ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>