<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:LibraryCatalog.ViewModels"
             x:DataType="vm:CatalogViewModel"
             x:Class="LibraryCatalog.Views.CatalogView">
    <Design.DataContext>
        <vm:CatalogViewModel />
    </Design.DataContext>

    <DockPanel>
        <Button Classes="Link"
                DockPanel.Dock="Top"
                HorizontalAlignment="Right"
                Content="Check In"
                Margin="10"
                Command="{Binding CheckInCommand}"/>
        <TextBox DockPanel.Dock="Top" 
                 Watermark="Search books..." 
                 Text="{Binding SearchQuery}"
                 Margin="10"/>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Books}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding $parent[ItemsControl].((vm:CatalogViewModel)DataContext).BookSelectedCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                Width="280" Height="300"
                                Margin="5"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Top">
                            <StackPanel Width="260">
                                <Image Source="{Binding ImagePath, Converter={StaticResource PathToBookCoverConverter}}"
                                       Width="200" Height="200" 
                                       Stretch="Uniform"
                                       Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Authors}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Illustrators}"
                                           TextWrapping="Wrap"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>